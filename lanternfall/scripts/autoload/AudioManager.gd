extends Node
## Sound effects (pooled players) and looping music with crossfades.
## All audio files are generated by tools/gen_audio.py (original, synthesised).

const SFX := ["click", "select", "card", "draw", "hit", "hurt", "block", "gold", "potion", "zap", "dice",
	"flow", "heal", "buff", "debuff", "relic", "turn", "enemy_turn", "enemy_die", "victory", "defeat"]
const MUSIC_DB := -9.0
const POOL := 10

var _sfx: Dictionary = {}
var _players: Array = []
var _next := 0
var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var _current_music := ""
var _last_play: Dictionary = {}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for n in SFX:
		var path := "res://audio/%s.wav" % n
		if ResourceLoader.exists(path):
			_sfx[n] = load(path)
	for i in POOL:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_players.append(p)
	_music_a = AudioStreamPlayer.new()
	_music_b = AudioStreamPlayer.new()
	for m in [_music_a, _music_b]:
		add_child(m)
		m.volume_db = -80.0
		m.finished.connect(_on_music_finished.bind(m))


func sfx_on() -> bool:
	return SaveManager.profile.get("sfx_on", true)


func music_on() -> bool:
	return SaveManager.profile.get("music_on", true)


## Plays a sound effect. Rapid repeats of the same sound are throttled so stacks of hits stay clean.
func play(name: String, volume_db: float = 0.0, pitch_jitter: float = 0.06) -> void:
	if not sfx_on() or not _sfx.has(name):
		return
	var now := Time.get_ticks_msec()
	if now - int(_last_play.get(name, -1000)) < 45:
		return
	_last_play[name] = now
	var p: AudioStreamPlayer = _players[_next]
	_next = (_next + 1) % POOL
	p.stream = _sfx[name]
	p.volume_db = volume_db
	p.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	p.play()


func play_music(name: String) -> void:
	if name == _current_music:
		return
	_current_music = name
	if not music_on():
		_fade_out_all()
		return
	var path := "res://audio/music_%s.wav" % name
	if not ResourceLoader.exists(path):
		return
	var stream: AudioStream = load(path)
	if stream is AudioStreamWAV:
		stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
		stream.loop_begin = 0
		stream.loop_end = int(stream.get_length() * stream.mix_rate)
	# crossfade: the idle player takes the new track
	var incoming := _music_b if _music_a.playing and _music_a.volume_db > -60.0 else _music_a
	var outgoing := _music_a if incoming == _music_b else _music_b
	incoming.stream = stream
	incoming.volume_db = -40.0
	incoming.play()
	var tw := create_tween().set_parallel(true)
	tw.tween_property(incoming, "volume_db", MUSIC_DB, 1.2)
	if outgoing.playing:
		tw.tween_property(outgoing, "volume_db", -60.0, 1.0)
		tw.chain().tween_callback(outgoing.stop)


func refresh_music() -> void:
	var name := _current_music
	_current_music = ""
	if music_on():
		play_music(name)
	else:
		_fade_out_all()
		_current_music = name


func _fade_out_all() -> void:
	for m in [_music_a, _music_b]:
		if m.playing:
			var tw := create_tween()
			tw.tween_property(m, "volume_db", -60.0, 0.5)
			tw.tween_callback(m.stop)


func _on_music_finished(p: AudioStreamPlayer) -> void:
	# Fallback if a stream didn't loop natively.
	if p.volume_db > -60.0 and music_on():
		p.play()


func music_for_screen(screen: String, params: Dictionary) -> String:
	match screen:
		"menu", "char_select", "victory", "game_over":
			return "menu"
		"combat":
			return "boss" if params.get("kind", "") == "boss" else "combat"
	return "map"
